#!/usr/bin/env bash
set -Eeuo pipefail

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  link_dir="$(CDPATH='' cd -- "$(dirname -- "$script_source")" && pwd -P)"
  link_target="$(readlink -- "$script_source")"
  if [[ "$link_target" = /* ]]; then
    script_source="$link_target"
  else
    script_source="$link_dir/$link_target"
  fi
done
factory_root="$(CDPATH='' cd -- "$(dirname -- "$script_source")/.." && pwd -P)"
workspace_root="${MIYAGO_AGENT_WORKSPACE_ROOT:-$HOME/Project/AI/agent-workspace}"
dotfile_root="${MIYAGO_DOTFILE_ROOT:-$HOME/dotfile}"
core_binary="${MIYAGO_CONTEXT_HARNESS_BIN:-$HOME/.local/bin/miyago-context-harness}"

usage() {
  cat <<'EOF'
usage: agent-workflow <doctor|status|plan|bootstrap|sync|resume|checkpoint|handoff|runtime|experience|export|import|plugin|version>

Environment overrides:
  MIYAGO_AGENT_WORKSPACE_ROOT
  MIYAGO_DOTFILE_ROOT
  MIYAGO_CONTEXT_HARNESS_BIN
EOF
}

require_path() {
  local path="$1" label="$2"
  if [[ ! -e "$path" ]]; then
    printf 'missing: %s (%s)\n' "$label" "$path" >&2
    return 1
  fi
}

has_option() {
  local expected="$1"
  shift
  local arg
  for arg in "$@"; do
    [[ "$arg" == "$expected" ]] && return 0
  done
  return 1
}

run_core_with_cwd() {
  local action="$1"
  shift
  local command=("$core_binary" "$action" --workspace-root "$workspace_root")
  if ! has_option --cwd "$@"; then
    command+=(--cwd "$PWD")
  fi
  command+=("$@")
  exec "${command[@]}"
}

plugin_entrypoint() {
  local manifest="$1" value
  value="$(awk -F': ' '$1 == "entrypoint" { print $2; exit }' "$manifest")"
  [[ -n "$value" && "$value" != /* && "$value" != *monika* ]] || {
    printf 'invalid plugin entrypoint in %s\n' "$manifest" >&2
    return 1
  }
  local plugin_root entrypoint_dir resolved
  plugin_root="$(CDPATH='' cd -- "$(dirname -- "$manifest")" && pwd -P)"
  entrypoint_dir="$(CDPATH='' cd -- "$plugin_root/$(dirname -- "$value")" 2>/dev/null && pwd -P)" || {
    printf 'invalid plugin entrypoint directory in %s\n' "$manifest" >&2
    return 1
  }
  resolved="$entrypoint_dir/$(basename -- "$value")"
  case "$resolved" in
    "$factory_root"/*) printf '%s\n' "$resolved" ;;
    *) printf 'plugin entrypoint escapes factory root: %s\n' "$manifest" >&2; return 1 ;;
  esac
}

plugin() {
  local action="${1:-}" plugin_id='' plugin_root entrypoint manifest
  shift || true
  case "$action" in
    list)
      for manifest in "$factory_root"/plugins/*/manifest.yaml; do
        [[ -f "$manifest" ]] || continue
        basename -- "$(dirname -- "$manifest")"
      done | sort
      ;;
    doctor)
      for manifest in "$factory_root"/plugins/*/manifest.yaml; do
        [[ -f "$manifest" ]] || continue
        plugin_root="$(dirname -- "$manifest")"
        entrypoint="$(plugin_entrypoint "$manifest")"
        [[ -x "$entrypoint" ]] || { printf 'plugin entrypoint not executable: %s\n' "$entrypoint" >&2; return 1; }
        MIYAGO_PLUGIN_ID="$(basename -- "$plugin_root")" "$entrypoint" --health >/dev/null || return 1
        printf 'plugin: OK (%s)\n' "$(basename -- "$plugin_root")"
      done
      ;;
    run|plan|health)
      while (($#)); do
        case "$1" in
          --id) plugin_id="${2:?missing value for --id}"; shift 2 ;;
          *) break ;;
        esac
      done
      [[ -n "$plugin_id" ]] || { printf 'plugin %s requires --id\n' "$action" >&2; return 2; }
      plugin_root="$factory_root/plugins/$plugin_id"
      manifest="$plugin_root/manifest.yaml"
      require_path "$manifest" "plugin-$plugin_id-manifest"
      entrypoint="$(plugin_entrypoint "$manifest")"
      require_path "$entrypoint" "plugin-$plugin_id-entrypoint"
      case "$action" in
        health) exec env MIYAGO_PLUGIN_ID="$plugin_id" "$entrypoint" --health "$@" ;;
        *) exec env MIYAGO_PLUGIN_ID="$plugin_id" "$entrypoint" "$action" "$@" ;;
      esac
      ;;
    *) printf 'usage: agent-workflow plugin <list|doctor|health|plan|run> ...\n' >&2; return 2 ;;
  esac
}

doctor() {
  require_path "$workspace_root/routing.yaml" workspace-routing
  require_path "$workspace_root/records/tasks/index.yaml" task-registry
  require_path "$dotfile_root/config/ai/AGENT-ENTRY.md" canonical-entry
  require_path "$dotfile_root/config/ai/AGENTS.md" shared-rules
  require_path "$core_binary" context-harness-binary
  printf 'non-entry: configured exclusion (not inspected)\n'
  local runtime generated
  for runtime in codex claude gemini grok; do
    case "$runtime" in
      gemini) generated="$dotfile_root/config/ai/generated/gemini/GEMINI.md" ;;
      *) generated="$dotfile_root/config/ai/generated/$runtime/AGENTS.md" ;;
    esac
    require_path "$generated" "$runtime-generated-entry"
  done
  printf '%s\n' 'status: OK'
  printf 'factory_root: %s\nworkspace_root: %s\ndotfile_root: %s\n' \
    "$factory_root" "$workspace_root" "$dotfile_root"
}

runtime() {
  local action="${1:-}" runtime_name=""
  shift || true
  case "$action" in
    list)
      printf '%s\n' codex claude gemini grok
      ;;
    doctor)
      require_path "$dotfile_root/script/common/check_agent_rule_sync.sh" runtime-sync-check
      bash "$dotfile_root/script/common/check_agent_rule_sync.sh"
      ;;
    sync)
      local sync_all=0
      while (($#)); do
        case "$1" in
          --runtime) runtime_name="${2:?missing value for --runtime}"; shift 2 ;;
          --all) sync_all=1; shift ;;
          *) printf 'unknown runtime sync option: %s\n' "$1" >&2; return 2 ;;
        esac
      done
      if ((sync_all)); then
        [[ -z "$runtime_name" ]] || { printf '%s\n' '--all cannot be combined with --runtime' >&2; return 2; }
        for runtime_name in codex claude gemini grok; do
          runtime sync --runtime "$runtime_name"
        done
        return 0
      fi
      [[ -n "$runtime_name" ]] || { printf '%s\n' 'runtime sync requires --runtime RUNTIME or --all' >&2; return 2; }
      case "$runtime_name" in
        codex|claude|gemini|grok) ;;
        *) printf 'unsupported runtime: %s\n' "$runtime_name" >&2; return 2 ;;
      esac
      local setup_script="$dotfile_root/script/common/setup_${runtime_name}.sh"
      require_path "$setup_script" "$runtime_name-setup-script"
      bash "$setup_script"
      ;;
    *)
      printf '%s\n' 'usage: agent-workflow runtime <list|doctor|sync> [--runtime RUNTIME|--all]' >&2
      return 2
      ;;
  esac
}

bootstrap() {
  local runtime='' cwd="$PWD" task=''
  while (($#)); do
    case "$1" in
      --runtime) runtime="${2:?missing value for --runtime}"; shift 2 ;;
      --cwd) cwd="${2:?missing value for --cwd}"; shift 2 ;;
      --task) task="${2:?missing value for --task}"; shift 2 ;;
      *) printf 'unknown bootstrap option: %s\n' "$1" >&2; return 2 ;;
    esac
  done
  [[ -n "$runtime" ]] || { printf 'bootstrap requires --runtime\n' >&2; return 2; }
  local args=(sync --runtime "$runtime" --cwd "$cwd" --workspace-root "$workspace_root")
  [[ -n "$task" ]] && args+=(--task "$task")
  exec "$core_binary" "${args[@]}"
}

experience() {
  local action="${1:-}"
  shift || true
  case "$action" in
    observe|organize|review|decide|consume|feedback)
      run_core_with_cwd "$action" "$@"
      ;;
    sync)
      run_core_with_cwd sync "$@"
      ;;
    export|import)
      exec "$core_binary" "$action" --workspace-root "$workspace_root" "$@"
      ;;
    *)
      printf '%s\n' 'usage: agent-workflow experience <observe|organize|review|decide|consume|feedback|sync|export|import> ...' >&2
      return 2
      ;;
  esac
}

case "${1:-}" in
  install) shift; exec "$factory_root/install.sh" "$@" ;;
  doctor) shift; (($# == 0)) || { usage >&2; exit 2; }; doctor ;;
  status) shift; run_core_with_cwd status "$@" ;;
  plan) shift; exec "$core_binary" plan --workspace-root "$workspace_root" "$@" ;;
  bootstrap|sync) shift; bootstrap "$@" ;;
  resume) shift; run_core_with_cwd resume "$@" ;;
  checkpoint) shift; run_core_with_cwd checkpoint "$@" ;;
  handoff) shift; run_core_with_cwd handoff "$@" ;;
  runtime) shift; runtime "$@" ;;
  experience) shift; experience "$@" ;;
  export) shift; exec "$core_binary" export --workspace-root "$workspace_root" "$@" ;;
  import) shift; exec "$core_binary" import --workspace-root "$workspace_root" "$@" ;;
  plugin) shift; plugin "$@" ;;
  version) printf '%s\n' 'agent-workflow-factory 0.1.0' ;;
  *) usage >&2; exit 2 ;;
esac
