#!/usr/bin/env bash
set -Eeuo pipefail

factory_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
workspace_root="${MIYAGO_AGENT_WORKSPACE_ROOT:-$HOME/Project/AI/agent-workspace}"
dotfile_root="${MIYAGO_DOTFILE_ROOT:-$HOME/dotfile}"
core_binary="${MIYAGO_CONTEXT_HARNESS_BIN:-$HOME/.local/bin/miyago-context-harness}"

usage() {
  cat <<'EOF'
usage: agent-workflow <doctor|status|plan|bootstrap|sync|export|import|plugin|version>

Environment overrides:
  MIYAGO_AGENT_WORKSPACE_ROOT
  MIYAGO_DOTFILE_ROOT
  MIYAGO_CONTEXT_HARNESS_BIN
EOF
}

require_path() {
  local path="$1" label="$2"
  if [[ ! -e "$path" ]]; then
    printf 'missing: %s (%s)\n' "$label" "$path" >&2
    return 1
  fi
}

plugin_entrypoint() {
  local manifest="$1" value
  value="$(awk -F': ' '$1 == "entrypoint" { print $2; exit }' "$manifest")"
  [[ -n "$value" && "$value" != /* && "$value" != *monika* ]] || {
    printf 'invalid plugin entrypoint in %s\n' "$manifest" >&2
    return 1
  }
  printf '%s/%s\n' "$(dirname -- "$manifest")" "$value"
}

plugin() {
  local action="${1:-}" plugin_id='' plugin_root entrypoint manifest
  shift || true
  case "$action" in
    list)
      for manifest in "$factory_root"/plugins/*/manifest.yaml; do
        [[ -f "$manifest" ]] || continue
        basename -- "$(dirname -- "$manifest")"
      done | sort
      ;;
    doctor)
      for manifest in "$factory_root"/plugins/*/manifest.yaml; do
        [[ -f "$manifest" ]] || continue
        plugin_root="$(dirname -- "$manifest")"
        entrypoint="$(plugin_entrypoint "$manifest")"
        [[ -x "$entrypoint" ]] || { printf 'plugin entrypoint not executable: %s\n' "$entrypoint" >&2; return 1; }
        MIYAGO_PLUGIN_ID="$(basename -- "$plugin_root")" "$entrypoint" --health >/dev/null || return 1
        printf 'plugin: OK (%s)\n' "$(basename -- "$plugin_root")"
      done
      ;;
    run|plan|health)
      while (($#)); do
        case "$1" in
          --id) plugin_id="${2:?missing value for --id}"; shift 2 ;;
          *) break ;;
        esac
      done
      [[ -n "$plugin_id" ]] || { printf 'plugin %s requires --id\n' "$action" >&2; return 2; }
      plugin_root="$factory_root/plugins/$plugin_id"
      manifest="$plugin_root/manifest.yaml"
      require_path "$manifest" "plugin-$plugin_id-manifest"
      entrypoint="$(plugin_entrypoint "$manifest")"
      require_path "$entrypoint" "plugin-$plugin_id-entrypoint"
      case "$action" in
        health) exec env MIYAGO_PLUGIN_ID="$plugin_id" "$entrypoint" --health "$@" ;;
        *) exec env MIYAGO_PLUGIN_ID="$plugin_id" "$entrypoint" "$action" "$@" ;;
      esac
      ;;
    *) printf 'usage: agent-workflow plugin <list|doctor|health|plan|run> ...\n' >&2; return 2 ;;
  esac
}

doctor() {
  require_path "$workspace_root/routing.yaml" workspace-routing
  require_path "$workspace_root/records/tasks/index.yaml" task-registry
  require_path "$dotfile_root/config/ai/AGENT-ENTRY.md" canonical-entry
  require_path "$dotfile_root/config/ai/AGENTS.md" shared-rules
  require_path "$core_binary" context-harness-binary
  if [[ -e "$HOME/Project/AI/monika" ]]; then
    printf 'non-entry: excluded and not inspected\n'
  fi
  local runtime generated
  for runtime in codex claude gemini grok; do
    case "$runtime" in
      gemini) generated="$dotfile_root/config/ai/generated/gemini/GEMINI.md" ;;
      *) generated="$dotfile_root/config/ai/generated/$runtime/AGENTS.md" ;;
    esac
    require_path "$generated" "$runtime-generated-entry"
  done
  printf '%s\n' 'status: OK'
  printf 'factory_root: %s\nworkspace_root: %s\ndotfile_root: %s\n' \
    "$factory_root" "$workspace_root" "$dotfile_root"
}

bootstrap() {
  local runtime='' cwd="$PWD" task=''
  while (($#)); do
    case "$1" in
      --runtime) runtime="${2:?missing value for --runtime}"; shift 2 ;;
      --cwd) cwd="${2:?missing value for --cwd}"; shift 2 ;;
      --task) task="${2:?missing value for --task}"; shift 2 ;;
      *) printf 'unknown bootstrap option: %s\n' "$1" >&2; return 2 ;;
    esac
  done
  [[ -n "$runtime" ]] || { printf 'bootstrap requires --runtime\n' >&2; return 2; }
  local args=(sync --runtime "$runtime" --cwd "$cwd" --workspace-root "$workspace_root")
  [[ -n "$task" ]] && args+=(--task "$task")
  exec "$core_binary" "${args[@]}"
}

case "${1:-}" in
  install) shift; exec "$factory_root/install.sh" "$@" ;;
  doctor) shift; (($# == 0)) || { usage >&2; exit 2; }; doctor ;;
  status) shift; exec "$core_binary" status --workspace-root "$workspace_root" --cwd "$PWD" "$@" ;;
  plan) shift; exec "$core_binary" plan --workspace-root "$workspace_root" "$@" ;;
  bootstrap|sync) shift; bootstrap "$@" ;;
  export) shift; exec "$core_binary" export --workspace-root "$workspace_root" "$@" ;;
  import) shift; exec "$core_binary" import --workspace-root "$workspace_root" "$@" ;;
  plugin) shift; plugin "$@" ;;
  version) printf '%s\n' 'agent-workflow-factory 0.1.0' ;;
  *) usage >&2; exit 2 ;;
esac
