#!/usr/bin/env bash
set -Eeuo pipefail

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  link_dir="$(CDPATH='' cd -- "$(dirname -- "$script_source")" && pwd -P)"
  link_target="$(readlink -- "$script_source")"
  if [[ "$link_target" = /* ]]; then
    script_source="$link_target"
  else
    script_source="$link_dir/$link_target"
  fi
done
factory_root="$(CDPATH='' cd -- "$(dirname -- "$script_source")/.." && pwd -P)"
config_file="${AGENT_FACTORY_CONFIG_FILE:-${MIYAGO_AGENT_WORKFLOW_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-experience/factory.env}}"
if [[ -f "$config_file" ]]; then
  # This file is generated by install.sh and contains only source-root paths.
  # Explicit environment variables below still take precedence.
  source "$config_file"
fi
workspace_root="${AGENT_FACTORY_WORKSPACE_ROOT:-${MIYAGO_AGENT_WORKSPACE_ROOT:-$HOME/agent-workspace}}"
dotfile_root="${AGENT_FACTORY_DOTFILE_ROOT:-${MIYAGO_DOTFILE_ROOT:-$HOME/dotfile}}"
core_binary="${AGENT_CONTEXT_HARNESS_BIN:-${MIYAGO_CONTEXT_HARNESS_BIN:-$HOME/.local/bin/miyago-context-harness}}"
runtime_config_dir="${AGENT_FACTORY_RUNTIME_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-experience}"
data_root="${AGENT_FACTORY_DATA_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/agent-experience}"
non_entry_root="${AGENT_FACTORY_NON_ENTRY_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-experience/non-entry}"
default_task_id="${AGENT_FACTORY_DEFAULT_TASK_ID:-}"
export AGENT_FACTORY_WORKSPACE_ROOT="$workspace_root"
export AGENT_FACTORY_ROOT="${AGENT_FACTORY_ROOT:-$factory_root}"
export AGENT_FACTORY_DOTFILE_ROOT="$dotfile_root"
export AGENT_CONTEXT_HARNESS_BIN="$core_binary"
export AGENT_FACTORY_RUNTIME_CONFIG_DIR="$runtime_config_dir"
export AGENT_FACTORY_DATA_ROOT="$data_root"
export AGENT_FACTORY_NON_ENTRY_ROOT="$non_entry_root"
# Compatibility exports for older Context Harness and dotfile adapters.
export MIYAGO_AGENT_WORKSPACE_ROOT="$workspace_root"
export MIYAGO_AGENT_FACTORY_ROOT="$factory_root"
export MIYAGO_DOTFILE_ROOT="$dotfile_root"
export MIYAGO_CONTEXT_HARNESS_BIN="$core_binary"
export MIYAGO_AGENT_DATA_ROOT="$data_root"
export MIYAGO_NON_ENTRY_ROOT="$non_entry_root"

usage() {
  cat <<'EOF'
usage: agent-workflow <doctor|status|plan|route|session-start|bootstrap|sync|resume|checkpoint|handoff|runtime|experience|export|import|plugin|version>

Environment overrides:
  AGENT_FACTORY_WORKSPACE_ROOT
  AGENT_FACTORY_DOTFILE_ROOT
  AGENT_CONTEXT_HARNESS_BIN
  AGENT_FACTORY_RUNTIME_CONFIG_DIR
  AGENT_FACTORY_DEFAULT_TASK_ID  optional local fallback task
EOF
}

require_path() {
  local path="$1" label="$2"
  if [[ ! -e "$path" ]]; then
    printf 'missing: %s (%s)\n' "$label" "$path" >&2
    return 1
  fi
}

has_option() {
  local expected="$1"
  shift
  local arg
  for arg in "$@"; do
    [[ "$arg" == "$expected" ]] && return 0
  done
  return 1
}

option_value() {
  local expected="$1"
  shift
  while (($#)); do
    if [[ "$1" == "$expected" ]]; then
      printf '%s\n' "${2:-}"
      return 0
    fi
    shift
  done
  return 1
}

resolve_task_for_cwd() {
  local cwd="$1"
  shift
  case "$cwd" in
    "$non_entry_root"|"$non_entry_root"/*) return 1 ;;
  esac
  if has_option --task "$@"; then
    option_value --task "$@"
    return 0
  fi
  if [[ -n "${MIYAGO_TASK_ID:-}" ]]; then
    printf '%s\n' "$MIYAGO_TASK_ID"
    return 0
  fi
  local discovered
  if discovered="$($core_binary discover --workspace-root "$workspace_root" --cwd "$cwd" 2>/dev/null)"; then
    printf '%s\n' "$discovered" | awk -F': ' '$1 == "task_id" { print $2; exit }'
    return 0
  fi
  [[ -n "$default_task_id" ]] || return 1
  printf '%s\n' "$default_task_id"
}

run_core_with_cwd() {
  local action="$1"
  shift
  local cwd
  cwd="$(option_value --cwd "$@" 2>/dev/null || true)"
  [[ -n "$cwd" ]] || cwd="$PWD"
  local command=("$core_binary" "$action" --workspace-root "$workspace_root")
  if ! has_option --cwd "$@"; then
    command+=(--cwd "$cwd")
  fi
  if ! has_option --task "$@" && [[ -z "${MIYAGO_TASK_ID:-}" ]] && [[ -n "$default_task_id" ]]; then
    if ! "$core_binary" discover --workspace-root "$workspace_root" --cwd "$cwd" >/dev/null 2>&1; then
      command+=(--task "$default_task_id")
    fi
  fi
  command+=("$@")
  exec "${command[@]}"
}

plugin_entrypoint() {
  local manifest="$1" value
  value="$(awk -F': ' '$1 == "entrypoint" { print $2; exit }' "$manifest")"
  [[ -n "$value" && "$value" != /* && "$value" != *monika* ]] || {
    printf 'invalid plugin entrypoint in %s\n' "$manifest" >&2
    return 1
  }
  local plugin_root entrypoint_dir resolved
  plugin_root="$(CDPATH='' cd -- "$(dirname -- "$manifest")" && pwd -P)"
  entrypoint_dir="$(CDPATH='' cd -- "$plugin_root/$(dirname -- "$value")" 2>/dev/null && pwd -P)" || {
    printf 'invalid plugin entrypoint directory in %s\n' "$manifest" >&2
    return 1
  }
  resolved="$entrypoint_dir/$(basename -- "$value")"
  case "$resolved" in
    "$factory_root"/*) printf '%s\n' "$resolved" ;;
    *) printf 'plugin entrypoint escapes factory root: %s\n' "$manifest" >&2; return 1 ;;
  esac
}

plugin() {
  local action="${1:-}" plugin_id='' plugin_root entrypoint manifest
  shift || true
  case "$action" in
    list)
      for manifest in "$factory_root"/plugins/*/manifest.yaml; do
        [[ -f "$manifest" ]] || continue
        basename -- "$(dirname -- "$manifest")"
      done | sort
      ;;
    doctor)
      for manifest in "$factory_root"/plugins/*/manifest.yaml; do
        [[ -f "$manifest" ]] || continue
        plugin_root="$(dirname -- "$manifest")"
        entrypoint="$(plugin_entrypoint "$manifest")"
        [[ -x "$entrypoint" ]] || { printf 'plugin entrypoint not executable: %s\n' "$entrypoint" >&2; return 1; }
        AGENT_PLUGIN_ID="$(basename -- "$plugin_root")" "$entrypoint" --health >/dev/null || return 1
        printf 'plugin: OK (%s)\n' "$(basename -- "$plugin_root")"
      done
      ;;
    run|plan|health)
      while (($#)); do
        case "$1" in
          --id) plugin_id="${2:?missing value for --id}"; shift 2 ;;
          *) break ;;
        esac
      done
      [[ -n "$plugin_id" ]] || { printf 'plugin %s requires --id\n' "$action" >&2; return 2; }
      plugin_root="$factory_root/plugins/$plugin_id"
      manifest="$plugin_root/manifest.yaml"
      require_path "$manifest" "plugin-$plugin_id-manifest"
      entrypoint="$(plugin_entrypoint "$manifest")"
      require_path "$entrypoint" "plugin-$plugin_id-entrypoint"
      case "$action" in
        health) exec env AGENT_PLUGIN_ID="$plugin_id" "$entrypoint" --health "$@" ;;
        *) exec env AGENT_PLUGIN_ID="$plugin_id" "$entrypoint" "$action" "$@" ;;
      esac
      ;;
    *) printf 'usage: agent-workflow plugin <list|doctor|health|plan|run> ...\n' >&2; return 2 ;;
  esac
}

doctor() {
  require_path "$workspace_root/routing.yaml" workspace-routing
  require_path "$workspace_root/records/tasks/index.yaml" task-registry
  require_path "$dotfile_root/config/ai/AGENT-ENTRY.md" canonical-entry
  require_path "$dotfile_root/config/ai/AGENTS.md" shared-rules
  require_path "$core_binary" context-harness-binary
  route_probe="$($core_binary route --workspace-root "$workspace_root" --cwd "$workspace_root" --query '目前 routing 的設定在哪裡' 2>/dev/null)" || {
    printf '%s\n' 'routing-source-registry: FAILED' >&2
    return 1
  }
  printf '%s\n' "$route_probe" | grep -Fq 'source_adapter:' || {
    printf '%s\n' 'routing-source-registry: invalid RoutePlan' >&2
    return 1
  }
  printf '%s\n' 'routing-source-registry: OK'
  printf 'non-entry: configured exclusion (not inspected)\n'
  local runtime generated
  for runtime in codex claude gemini grok opencode; do
    case "$runtime" in
      gemini) generated="$dotfile_root/config/ai/generated/gemini/GEMINI.md" ;;
      opencode) generated="$dotfile_root/config/opencode/opencode.json" ;;
      *) generated="$dotfile_root/config/ai/generated/$runtime/AGENTS.md" ;;
    esac
    require_path "$generated" "$runtime-generated-entry"
  done
  require_path "$runtime_config_dir/AGENTS.md" opencode-shared-rules
  require_path "$runtime_config_dir/personal-model/PROFILE.md" opencode-personal-model
  if command -v opencode >/dev/null 2>&1; then
    opencode --help >/dev/null 2>&1 || {
      printf '%s\n' 'opencode-cli: FAILED' >&2
      return 1
    }
    printf '%s\n' 'opencode-cli: OK'
  else
    printf '%s\n' 'opencode-cli: capability gap (executable not found)'
  fi
  printf '%s\n' 'status: OK'
  printf 'factory_root: %s\nworkspace_root: %s\ndotfile_root: %s\n' \
    "$factory_root" "$workspace_root" "$dotfile_root"
}

runtime() {
  local action="${1:-}" runtime_name=""
  shift || true
  case "$action" in
    list)
      printf '%s\n' codex claude gemini grok opencode
      ;;
    doctor)
      require_path "$dotfile_root/script/common/check_agent_rule_sync.sh" runtime-sync-check
      bash "$dotfile_root/script/common/check_agent_rule_sync.sh"
      ;;
    sync)
      local sync_all=0
      while (($#)); do
        case "$1" in
          --runtime) runtime_name="${2:?missing value for --runtime}"; shift 2 ;;
          --all) sync_all=1; shift ;;
          *) printf 'unknown runtime sync option: %s\n' "$1" >&2; return 2 ;;
        esac
      done
      if ((sync_all)); then
        [[ -z "$runtime_name" ]] || { printf '%s\n' '--all cannot be combined with --runtime' >&2; return 2; }
        for runtime_name in codex claude gemini grok opencode; do
          runtime sync --runtime "$runtime_name"
        done
        return 0
      fi
      [[ -n "$runtime_name" ]] || { printf '%s\n' 'runtime sync requires --runtime RUNTIME or --all' >&2; return 2; }
      case "$runtime_name" in
        codex|claude|gemini|grok|opencode) ;;
        *) printf 'unsupported runtime: %s\n' "$runtime_name" >&2; return 2 ;;
      esac
      local setup_script="$dotfile_root/script/common/setup_${runtime_name}.sh"
      require_path "$setup_script" "$runtime_name-setup-script"
      bash "$setup_script"
      ;;
    *)
      printf '%s\n' 'usage: agent-workflow runtime <list|doctor|sync> [--runtime RUNTIME|--all]' >&2
      return 2
      ;;
  esac
}

bootstrap() {
  local runtime='' cwd="$PWD" task='' experience_task=''
  while (($#)); do
    case "$1" in
      --runtime) runtime="${2:?missing value for --runtime}"; shift 2 ;;
      --cwd) cwd="${2:?missing value for --cwd}"; shift 2 ;;
      --task) task="${2:?missing value for --task}"; shift 2 ;;
      --experience-task) experience_task="${2:?missing value for --experience-task}"; shift 2 ;;
      *) printf 'unknown bootstrap option: %s\n' "$1" >&2; return 2 ;;
    esac
  done
  [[ -n "$runtime" ]] || { printf 'bootstrap requires --runtime\n' >&2; return 2; }
  local args=(--runtime "$runtime" --cwd "$cwd")
  [[ -n "$task" ]] && args+=(--task "$task")
  [[ -n "$experience_task" ]] && args+=(--experience-task "$experience_task")
  session_start "${args[@]}"
}

session_start() {
  local runtime='' cwd="$PWD" task='' experience_task=''
  while (($#)); do
    case "$1" in
      --runtime) runtime="${2:?missing value for --runtime}"; shift 2 ;;
      --cwd) cwd="${2:?missing value for --cwd}"; shift 2 ;;
      --task) task="${2:?missing value for --task}"; shift 2 ;;
      --experience-task) experience_task="${2:?missing value for --experience-task}"; shift 2 ;;
      *) printf 'unknown session-start option: %s\n' "$1" >&2; return 2 ;;
    esac
  done
  if [[ -z "$task" ]]; then
    task="$(resolve_task_for_cwd "$cwd" --cwd "$cwd")" || {
      # Context Harness creates a scoped local task when `plan` has no task.
      # Factory used to stop at discover and made a fresh session look broken.
      if "$core_binary" plan --workspace-root "$workspace_root" --cwd "$cwd" >/dev/null 2>&1; then
        task="$(resolve_task_for_cwd "$cwd" --cwd "$cwd")" || true
        if [[ -n "$task" ]]; then
          printf '%s\n' 'task_action: created_local_scope' >&2
        fi
      fi
      if [[ -z "$task" ]]; then
        printf '%s\n' 'context-harness: no task selected; continuing without historical context' >&2
        printf '%s\n' 'session_action: fresh'
        return 0
      fi
    }
  fi
  printf 'selected_task: %s\n' "$task"
  if ! "$core_binary" resume --workspace-root "$workspace_root" --cwd "$cwd" --task "$task"; then
    printf 'context-harness: resume failed for %s; continuing without historical context\n' "$task" >&2
    printf '%s\n' 'session_action: continue_without_context'
    return 0
  fi
  if [[ -n "$runtime" ]]; then
    local sync_tasks=()
    if [[ -n "$experience_task" ]]; then
      sync_tasks+=("$experience_task")
    else
      sync_tasks+=(personal-experience-autocapture)
      [[ "$task" == personal-experience-autocapture ]] || sync_tasks+=("$task")
    fi
    local current_experience_task sync_args
    for current_experience_task in "${sync_tasks[@]}"; do
      sync_args=(sync --workspace-root "$workspace_root" --cwd "$cwd" --task "$task" --runtime "$runtime" --experience-task "$current_experience_task")
      if ! "$core_binary" "${sync_args[@]}"; then
        printf 'context-harness: experience sync failed for %s; continuing with resumed context\n' "$current_experience_task" >&2
        printf '%s\n' 'session_action: continue_without_experience_sync'
      fi
    done
  fi
}

experience() {
  local action="${1:-}"
  shift || true
  case "$action" in
    observe|organize|review|decide|consume|feedback)
      run_core_with_cwd "$action" "$@"
      ;;
    sync)
      run_core_with_cwd sync "$@"
      ;;
    export|import)
      exec "$core_binary" "$action" --workspace-root "$workspace_root" "$@"
      ;;
    *)
      printf '%s\n' 'usage: agent-workflow experience <observe|organize|review|decide|consume|feedback|sync|export|import> ...' >&2
      return 2
      ;;
  esac
}

case "${1:-}" in
  install) shift; exec "$factory_root/install.sh" "$@" ;;
  doctor) shift; (($# == 0)) || { usage >&2; exit 2; }; doctor ;;
  status) shift; run_core_with_cwd status "$@" ;;
  plan) shift; run_core_with_cwd plan "$@" ;;
  route) shift; run_core_with_cwd route "$@" ;;
  session-start) shift; session_start "$@" ;;
  bootstrap) shift; bootstrap "$@" ;;
  sync) shift; bootstrap "$@" ;;
  resume) shift; run_core_with_cwd resume "$@" ;;
  checkpoint) shift; run_core_with_cwd checkpoint "$@" ;;
  handoff) shift; run_core_with_cwd handoff "$@" ;;
  runtime) shift; runtime "$@" ;;
  experience) shift; experience "$@" ;;
  export) shift; exec "$core_binary" export --workspace-root "$workspace_root" "$@" ;;
  import) shift; exec "$core_binary" import --workspace-root "$workspace_root" "$@" ;;
  plugin) shift; plugin "$@" ;;
  version) printf '%s\n' 'agent-experience-factory 0.1.0' ;;
  *) usage >&2; exit 2 ;;
esac
